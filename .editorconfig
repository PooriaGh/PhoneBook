root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion

# var preferences
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-level preferences
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion

# Naming: _camelCase private fields
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_consts_pascal.symbols = private_consts
dotnet_naming_rule.private_consts_pascal.style = pascal
dotnet_naming_rule.private_consts_pascal.severity = warning
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Analyzer severities
# CA1848: LoggerMessage delegates — structured ILogger calls are acceptable for this project size.
dotnet_diagnostic.CA1848.severity = none
# CA1711: "Handler"/"Collection" suffixes are intentional (MediatR / xUnit conventions).
dotnet_diagnostic.CA1711.severity = none
# CA1716: identifiers like "Error" are intentional in the Result pattern.
dotnet_diagnostic.CA1716.severity = none
# CA1000: static members on generic types (Result<T>.Failure) are the point of the pattern.
dotnet_diagnostic.CA1000.severity = none
# CA2225: operator-overload alternates not needed for implicit Result conversions.
dotnet_diagnostic.CA2225.severity = none
# IDE0005 needs GenerateDocumentationFile; keep unused-usings as a suggestion.
dotnet_diagnostic.IDE0005.severity = suggestion

[tests/**.cs]
# Test method names use Method_Scenario_ExpectedResult.
dotnet_diagnostic.CA1707.severity = none
# xUnit async test methods don't need ConfigureAwait.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1861.severity = none
