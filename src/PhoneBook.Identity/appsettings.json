{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Identity": "Data Source=identity;Mode=Memory;Cache=Shared"
  },
  "Identity": {
    "Issuer": "https://localhost:7002/",
    "Audience": "phonebook-api",
    "AllowedCorsOrigins": [ "https://localhost:7001", "http://localhost:5001" ],
    "Clients": [],
    "Users": []
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  },
  "RateLimiting": {
    "Token": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "AllowedHosts": "*"
}
