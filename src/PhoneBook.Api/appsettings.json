{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=phonebook;Mode=Memory;Cache=Shared"
  },
  "Auth": {
    "Authority": "https://localhost:7002/",
    "PublicAuthority": "https://localhost:7002",
    "Audience": "phonebook-api"
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  },
  "RateLimiting": {
    "Api": { "PermitLimit": 100, "WindowSeconds": 60 }
  },
  "AllowedHosts": "*"
}
